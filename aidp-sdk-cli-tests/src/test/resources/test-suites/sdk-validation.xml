<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="aidp_sdk_validation" verbose="2" parallel="classes" thread-count="4">
  <listeners>
    <listener class-name="com.oracle.aidp.sdk.logging.SdkTestListener"/>
  </listeners>
  <test name="sdk_validation">
    <groups>
      <run>
        <include name="rel_validation"/>
      </run>
    </groups>
    <packages>
      <package name="com.oracle.aidp.sdk.*"/>
    </packages>
  </test>
</suite>
