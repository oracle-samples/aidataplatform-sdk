{
  "name": "aidp-typescript-client",
  "version": "1.0.2",
  "description": "TypeScript SDK for the AI Data Platform Data Plane APIs.",
  "keywords": [
    "oracle",
    "aidp",
    "ai-data-platform",
    "typescript-sdk"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "index.ts",
    "npm-shrinkwrap.json",
    "lib/**/*",
    "dist/**/*",
    "LICENSE.txt",
    "NOTICE.txt"
  ],
  "scripts": {
    "build": "./node_modules/typescript/bin/tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oracle-samples/aidataplatform-sdk.git",
    "directory": "aidp-typescript-client"
  },
  "author": {
    "name": "Oracle Cloud Infrastructure",
    "email": ""
  },
  "license": "UPL-1.0",
  "dependencies": {
    "oci-common": "2.126.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/node-fetch": "^2.6.12",
    "typescript": "^5.8.3"
  }
}
