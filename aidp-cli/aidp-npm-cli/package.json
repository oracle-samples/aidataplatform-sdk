{
  "name": "aidp-cli",
  "version": "2.0.2",
  "description": "Command line interface for Oracle AI Data Platform Workbench.",
  "keywords": [
    "oracle",
    "aidp",
    "ai-data-platform",
    "cli"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "aidp": "./dist/bin/aidp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "README.md",
    "dist/**/*.d.ts",
    "dist/**/*.js",
    "dist/**/*.json",
    "LICENSE.txt",
    "NOTICE.txt"
  ],
  "scripts": {
    "build": "./node_modules/typescript/bin/tsc -p tsconfig.json",
    "generate-manifest": "node scripts/generate_manifest.js",
    "test": "npm run build && npm run generate-manifest && node test/run_tests.js",
    "write-version": "node scripts/write_version.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oracle-samples/aidataplatform-sdk.git",
    "directory": "aidp-cli/aidp-npm-cli"
  },
  "author": {
    "name": "Oracle Cloud Infrastructure",
    "email": ""
  },
  "license": "UPL-1.0",
  "dependencies": {
    "aidp-typescript-client": "file:../../aidp-typescript-client",
    "oci-common": "2.126.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/node-fetch": "^2.6.12",
    "typescript": "^5.8.3"
  }
}
